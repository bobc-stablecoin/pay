# Public Privy app ID from your Privy dashboard. Enable email and wallet login.
VITE_PRIVY_APP_ID=

# Deployed Arbitrum One VaultEngine. BOBC and oracle addresses are read from it.
VITE_VAULT_ENGINE_ADDRESS=

# Optional public Arbitrum One RPC. Defaults to https://arb1.arbitrum.io/rpc.
VITE_ARBITRUM_RPC_URL=
